<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tomazbr9.controller.AtivacaoController"
      alignment="CENTER"
      spacing="16"
      prefWidth="650"
      prefHeight="410">

    <padding>
        <Insets top="30" bottom="30"
                left="35" right="35"/>
    </padding>

    <Label text="Ativação do Auto-Nota"
           textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="25"/>
        </font>
    </Label>

    <Label text="Licença vitalícia por computador"
           textFill="#7f8c8d"/>

    <Separator/>

    <Label text="Identificação deste computador"
           style="-fx-font-weight: bold;"/>

    <HBox alignment="CENTER"
          spacing="10">

        <TextField fx:id="txtIdentificacao"
                   editable="false"
                   prefWidth="465"
                   style="-fx-font-family: monospace;"/>

        <Button text="Copiar"
                onAction="#copiarIdentificacao"
                prefWidth="85"/>

    </HBox>

    <Label text="Envie a identificação ao fornecedor para receber o arquivo de licença."
           wrapText="true"
           textAlignment="CENTER"
           textFill="#555555"/>

    <Label fx:id="lblStatus"
           text="Verificando licença..."
           textAlignment="CENTER"
           wrapText="true"
           textFill="#b45309"/>

    <Separator/>

    <Button text="Selecionar arquivo de licença (.lic)"
            onAction="#selecionarLicenca"
            prefWidth="290"
            prefHeight="45"
            style="-fx-background-color: #2980b9;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;"/>

    <Label text="A ativação funciona sem internet."
           textFill="#7f8c8d"/>

</VBox>
