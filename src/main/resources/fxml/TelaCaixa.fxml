<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tomazbr9.controller.CaixaController"
      prefWidth="760"
      prefHeight="700"
      spacing="12">

    <padding>
        <Insets top="20" right="20"
                bottom="20" left="20"/>
    </padding>

    <!-- TITULO -->

    <Label text="Caixa Rápido - Abastecimento"
           textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24"/>
        </font>
    </Label>

    <!-- MENU -->

    <HBox spacing="10">

        <Button text="Gerenciar Produtos"
                onAction="#abrirGerenciamentoProdutos"/>

        <Button text="Configurações"
                onAction="#abrirConfiguracoes"/>

        <Button text="Identificação da Máquina"
                onAction="#mostrarIdentificacaoComputador"/>

    </HBox>

    <Separator/>

    <!-- ADICIONAR PRODUTO -->

    <Label text="Adicionar Produto"
           style="-fx-font-size: 16px;
                  -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">

        <VBox spacing="5">

            <Label text="Produto"/>

            <ComboBox fx:id="cbProduto"
                      prefWidth="300"/>

        </VBox>

        <VBox spacing="5">

            <Label text="Quantidade"/>

            <TextField fx:id="txtQuantidade"
                       promptText="Ex: 20"
                       prefWidth="110"/>

        </VBox>

        <VBox spacing="5">

            <Label text="Subtotal (R$)"/>

            <TextField fx:id="txtValor"
                       promptText="0.00"
                       prefWidth="120"/>

        </VBox>

        <Button text="Adicionar"
                onAction="#adicionarItem"
                prefHeight="35"
                style="-fx-background-color: #27ae60;
                       -fx-text-fill: white;"/>

    </HBox>

    <Separator/>

    <!-- ITENS ADICIONADOS -->

    <Label text="Itens da Venda"
           style="-fx-font-size: 16px;
                  -fx-font-weight: bold;"/>

    <TableView fx:id="tabelaItens"
               prefHeight="230"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colProduto"
                         text="Produto"
                         prefWidth="280"/>

            <TableColumn fx:id="colQuantidade"
                         text="Quantidade"
                         prefWidth="130"/>

            <TableColumn fx:id="colUnitario"
                         text="Preço Unitário"
                         prefWidth="130"/>

            <TableColumn fx:id="colSubtotal"
                         text="Subtotal"
                         prefWidth="130"/>

        </columns>

    </TableView>

    <HBox alignment="CENTER_RIGHT">

        <Button text="Remover Item Selecionado"
                onAction="#removerItem"
                style="-fx-background-color: #dc3545;
                       -fx-text-fill: white;"/>

    </HBox>

    <Separator/>

    <!-- DADOS ADICIONAIS -->

    <Label text="Dados Adicionais (Opcional)"
           style="-fx-font-weight: bold;"/>

    <HBox spacing="10">

        <TextField fx:id="txtCpf"
                   promptText="CPF / CNPJ"
                   HBox.hgrow="ALWAYS"/>

        <TextField fx:id="txtPlaca"
                   promptText="Placa"
                   HBox.hgrow="ALWAYS"/>

        <TextField fx:id="txtKm"
                   promptText="Odômetro (KM)"
                   HBox.hgrow="ALWAYS"/>

    </HBox>

    <!-- TOTAL E FINALIZACAO -->

    <VBox alignment="CENTER"
          spacing="10"
          style="-fx-background-color: #ecf0f1;
                 -fx-padding: 15;
                 -fx-background-radius: 5;">

        <Label text="TOTAL DA VENDA">
            <font>
                <Font size="14"/>
            </font>
        </Label>

        <Label fx:id="lblTotalDestaque"
               text="R$ 0,00"
               textFill="#27ae60">
            <font>
                <Font name="System Bold" size="34"/>
            </font>
        </Label>

        <Button fx:id="btnFinalizar"
                text="FINALIZAR E IMPRIMIR"
                onAction="#finalizarVenda"
                prefWidth="250"
                prefHeight="40"
                style="-fx-background-color: #2980b9;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

    </VBox>

</VBox>
