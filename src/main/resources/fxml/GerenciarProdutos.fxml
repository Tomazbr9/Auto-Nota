<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox spacing="10" prefWidth="400" prefHeight="400" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tomazbr9.controller.ProdutoController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Gerenciar Preços" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tabelaProdutos" prefHeight="200" onMouseClicked="#selecionarProduto">
        <columns>
            <TableColumn fx:id="colNome" text="Combustível" prefWidth="200"/>
            <TableColumn fx:id="colPreco" text="Preço (R$)" prefWidth="100"/>
        </columns>
    </TableView>

    <GridPane vgap="10" hgap="10">
        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false"/>

        <Label text="Preço (R$):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPreco" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Atualizar Preço" onAction="#atualizarPreco" style="-fx-background-color: #27ae60; -fx-text-fill: white;" maxWidth="Infinity"/>
</VBox>