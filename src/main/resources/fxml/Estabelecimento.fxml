<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tomazbr9.controller.EstabelecimentoController"
      spacing="15"
      prefWidth="520"
      prefHeight="560">

    <padding>
        <Insets top="25" right="25"
                bottom="25" left="25"/>
    </padding>

    <Label text="Configurações do Estabelecimento">
        <font>
            <Font size="22"/>
        </font>
    </Label>

    <Separator/>

    <VBox spacing="5">
        <Label text="Nome do estabelecimento *"/>
        <TextField fx:id="txtNome"
                   promptText="Nome do posto"/>
    </VBox>

    <VBox spacing="5">
        <Label text="CNPJ *"/>
        <TextField fx:id="txtCnpj"
                   promptText="00.000.000/0000-00"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Endereço"/>
        <TextField fx:id="txtEndereco"
                   promptText="Rua, número e bairro"/>
    </VBox>

    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Cidade"/>
            <TextField fx:id="txtCidade"
                       promptText="Cidade"/>
        </VBox>

        <VBox spacing="5">
            <Label text="UF"/>
            <TextField fx:id="txtUf"
                       prefWidth="65"
                       promptText="SP"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="CEP"/>
            <TextField fx:id="txtCep"
                       promptText="00000-000"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Telefone"/>
            <TextField fx:id="txtTelefone"
                       promptText="(11) 99999-9999"/>
        </VBox>
    </HBox>

    <Separator/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancelar"
                onAction="#cancelar"/>

        <Button text="Salvar Configurações"
                onAction="#salvar"
                style="-fx-background-color: #2980b9;
                       -fx-text-fill: white;"/>
    </HBox>

</VBox>
